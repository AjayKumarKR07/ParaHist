# ── Dataset (do not upload large CSV to GitHub) ───────────────────────────────
dataset/

# ── Build output ──────────────────────────────────────────────────────────────
build/
cmake-build-*/
*.o
*.obj
*.exe
*.out
parahist

# ── CMake cache ───────────────────────────────────────────────────────────────
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake
!CMakeLists.txt

# ── Results (generated at runtime; not tracked unless intentional) ─────────────
results/*.csv
results/*.json

# ── Graphs (generated by Python scripts; regeneratable) ──────────────────────
graphs/*.png
graphs/*.svg
graphs/*.pdf

# ── Python cache ──────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd

# ── OS / editor ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*.swp
*.swo
.vscode/settings.json
.idea/

# -- Node.js / Web App --------------------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/
frontend/dist/
backend/.env
.env
npm-debug.log*
