# ParaHist Backend Environment Configuration
# Copy this file to .env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# PostgreSQL Persistent Database (pg)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/parahist

# JWT Authentication Secret
JWT_SECRET=parahist_secure_session_secret_key_2026

# C++ executable path (relative to project root, or absolute)
# Windows (MinGW): build/parahist.exe
# Linux/WSL:       build/parahist
CPP_EXECUTABLE=build/parahist

# Absolute path to the project root (parent of dataset/, results/, build/)
# Leave empty to auto-detect from __dirname
PROJECT_ROOT=

# Dataset path (relative to PROJECT_ROOT)
DATASET_PATH=dataset/train.csv

# Results directory (relative to PROJECT_ROOT)
RESULTS_DIR=results

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
